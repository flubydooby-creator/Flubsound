      "music": { "db": [0.7, 0.2, 0.8, 0.8, -2.7, -2.6, -2.3, -1.7, -1.9, -1.8], "toleranceDb": 1.5 }
    },
    "loudnessOffsetLu": { "pink": -0.1, "music": 2.3, "toleranceLu": 1.0 },
